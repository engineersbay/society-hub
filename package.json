{
  "name": "society-hub",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@society-hub/api",
    "dev:web": "turbo run dev --filter=@society-hub/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "bun test --coverage packages/auth packages/validation packages/sdk apps/api/src/lib/errors.test.ts apps/api/src/lib/auth-helpers.test.ts apps/api/src/config.test.ts",
    "test:integration": "bun test apps/api/src/api.integration.test.ts",
    "test:ci": "bun run test:unit && bun run test:integration",
    "setup": "bun install && bun run setup:env && bun run setup:db",
    "setup:env": "bash scripts/setup-env.sh",
    "setup:db": "bash scripts/setup-db.sh",
    "db:generate": "bun run --filter=@society-hub/api db:generate",
    "db:migrate": "bun run --filter=@society-hub/api db:migrate",
    "db:seed": "bun run --filter=@society-hub/api db:seed",
    "db:up": "docker compose -f devops/docker/docker-compose.yml up mysql -d"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.3.14"
}
